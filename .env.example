# Comma-separated frontend origins (scheme + hostname + port).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosting startup reads PORT; default is 8000.
PORT=8000
# Optional SQLite location. Default: tasks.db beside main.py.
# Set this to a writable persistent disk path when hosting.
# DB_PATH=/data/tasks.db
# Vercel demo: leave DB_PATH unset to use temporary SQLite storage automatically.
